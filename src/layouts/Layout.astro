---
export interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/images/hero-bg.webp' } = Astro.props;

const rawPath = Astro.url.pathname;
const normalizedPathRaw = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
const normalizedPath = normalizedPathRaw === '/index.html' ? '/' : normalizedPathRaw;
const canonicalPath =
	normalizedPath === '/' || normalizedPath.endsWith('.html')
		? normalizedPath
		: `${normalizedPath}.html`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;

const ogImageUrl = new URL(image, Astro.site).href;
const siteName = 'Mitsubishi Jogja – Sleman Yogyakarta';

import '../styles/style.css';
