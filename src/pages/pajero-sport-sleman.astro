---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import carsData from '../data/cars.json';

const car = carsData.cars.find(c => c.id === 'pajero');
const dakarVariants = car?.variants?.filter(v => v.group === 'Dakar') || [];
const exceedVariants = car?.variants?.filter(v => v.group === 'Exceed / GLX') || [];
---

<Layout title="Harga Pajero Sport Sleman 2026 | New SUV Diesel Terbaik – Mitsubishi Sleman" description="Harga dan promo Mitsubishi Pajero Sport terbaru di Sleman Yogyakarta 2026. Mesin 2.4L MIVEC Turbo 181 PS, 8-Speed AT, Diamond Sense. Hubungi Putra Sales Mitsubishi." image="/images/pajero-sport.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Pajero Sport 2026",
      "image": "https://mitsubishi-sleman.online/images/pajero-sport.webp",
      "description": "SUV premium legendaris dengan mesin diesel bertenaga 181 PS dan fitur keselamatan Diamond Sense. Tersedia di Sleman Yogyakarta melalui Putra Sales.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "Pajero Sport Dakar Ultimate 4x4 AT",
          "priceCurrency": "IDR",
          "price": "799000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
            "@type": "Offer",
            "name": "Pajero Sport Dakar Ultimate 4x2 AT",
            "priceCurrency": "IDR",
            "price": "737000000",
            "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "Pajero Sport Exceed 4x2 AT",
          "priceCurrency": "IDR",
          "price": "624500000",
          "availability": "https://schema.org/InStock"
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Pajero Sport" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Pajero Sport Sleman 2026</h1>
        <p>King of SUV. Power, Luxury, & Safety dalam satu paket Diesel MIVEC 181 PS. Promo Bunga 0% & Bonus V-Kool.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/pajero-sport.webp" alt="Mitsubishi Pajero Sport 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian -->
            <div class="product-card">
                <h2>Harga Pajero Sport Sleman 2026</h2>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian Dakar</th>
                            <th>Transmisi / Roda</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {dakarVariants.map((v) => (
                            <tr>
                                <td>{v.name}</td>
                                <td>{v.transmission}</td>
                                <td class="price-col">{v.price}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <table class="price-table" style="margin-top: 10px;">
                    <thead>
                        <tr>
                            <th>Varian Exceed / GLX</th>
                            <th>Transmisi / Roda</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {exceedVariants.map((v) => (
                            <tr>
                                <td>{v.name}</td>
                                <td>{v.transmission}</td>
                                <td class="price-col">{v.price}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo khusus bulan ini: Bunga 0% & Kaca Film V-Kool Original!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Canggihnya Fitur Pajero Sport</h2>
                <table class="spec-table">
                    <tr><th>Dimensi</th><td>4.840 x 1.815 x 1.835 mm</td></tr>
                    <tr><th>Mesin Dakar</th><td>2.4L 4N15 MIVEC Turbo Diesel, 181 PS</td></tr>
                    <tr><th>Mesin Exceed</th><td>2.5L 4D56 Commonrail Turbo, 136 PS</td></tr>
                    <tr><th>Torsi Maks</th><td>430 Nm @ 2.500 rpm (Tipe Dakar)</td></tr>
                    <tr><th>Transmisi</th><td>8-Speed AT (Dakar) / 5-Speed (Exceed)</td></tr>
                    <tr><th>Sistem 4WD</th><td>Super Select 4WD-II (Khusus 4x4)</td></tr>
                    <tr><th>Multimedia</th><td>8" Touch Screen & Roof Monitor (Ultimate)</td></tr>
                    <tr><th>Ground Clearance</th><td>218 mm (SUV Sejati)</td></tr>
                    <tr><th>Keselamatan</th><td>Diamond Sense, 7 Airbags, ASC, HSA, UMS</td></tr>
                    <tr><th>Fitur Premium</th><td>Sunroof, Kick Sensor Tailgate, Nanoe X</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">Diamond Sense (ADAS)</span>
                    <span class="feature-pill">Super Select 4WD-II</span>
                    <span class="feature-pill">Power Tailgate + Kick Sensor</span>
                    <span class="feature-pill">Sunroof</span>
                    <span class="feature-pill">8" Digital Meter</span>
                    <span class="feature-pill">Roof Monitor (Ultimate)</span>
                    <span class="feature-pill">Adaptive Cruise Control</span>
                    <span class="feature-pill">7 Airbags</span>
                </div>
            </div>

            <!-- Color Options -->
            <div class="product-card">
                <h2>Pilihan Warna Pajero Sport</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 1rem;">
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #6c757d; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Graphite Gray Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #e9ecef; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Blade Silver Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Quartz White Pearl</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #212529; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Jet Black Mica</p>
                    </div>
                </div>
                <p style="font-size: 0.75rem; color: var(--m-mid-grey); margin-top: 10px;">* Warna Graphite Gray tersedia khusus untuk varian Dakar dan Exceed.</p>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit Pajero Sport Sleman</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit Dakar Ultimate 4x4 (OTR Rp 799.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 159,8 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 19,2 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 14,3 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo Bunga</div>
                        <div class="k-value">0%</div>
                        <div class="k-sub">Hingga 12 bulan</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti & nego diskon maksimal.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Alasan Pilih Pajero Sport di Jogja</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">⛰️ Raja Tanjakan</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Mesin Diesel MIVEC 181 PS & Torsi 430 Nm. Sangat tangguh melibas tanjakan ekstrem Kaliurang hingga perbukitan Menoreh.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🕹️ Transmisi 8-Speed</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Perpindahan gigi 8-percepatan yang halus dan responsif. Memberikan kenyamanan mesin diesel yang tetap senyap dan efisien.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛡️ Keamanan Berlapis</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Dilengkapi Diamond Sense ADAS dan 7 Airbags untuk perlindungan total keluarga saat menjelajah berbagai destinasi wisata Jogja.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🌊 Ground Clearance Tinggi</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">GC 218 mm yang kokoh. Bebas cemas melewati jalanan berlubang, genangan air hujan, hingga jalur semi off-road di Gunungkidul.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/pajero-sport.webp"
                imageAlt="Pajero Sport"
                price="Rp 606 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20Pajero%20Sport%20di%20Sleman.%20Bisa%20info%20promo%20terbaru%3F"
                waButtonText="Tanya Promo Pajero"
                ctaId="wa-pajero-cta"
                features={["Test Drive Door to Door", "Promo Bunga 0%!", "Bonus Kaca Film V-Kool"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-sleman.html">→ New Xpander Sleman</a></li>
                    <li><a href="/xpander-cross-sleman.html">→ New Xpander Cross</a></li>
                    <li><a href="/xforce-jogja.html">→ New Xforce Jogja</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                    <li><a href="/blog/perbandingan-xpander-vs-xforce.html">Xpander vs Xforce</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Xpander Cross – SUV MPV", price: "Mulai Rp 350.000.000", image: "/images/xpander-cross.webp", alt: "Xpander Cross Sleman", href: "/xpander-cross-sleman.html" },
        { title: "New Xforce – Compact SUV", price: "Rp 391.500.000", image: "/images/xforce.webp", alt: "Xforce Jogja", href: "/xforce-jogja.html" },
        { title: "Mitsubishi Destinator – Premium", price: "Mulai Rp 400.000.000", image: "/images/destinator.webp", alt: "Destinator Sleman", href: "/destinator-sleman.html" },
        { title: "New Colt L300 – Jagonya Cuan", price: "Rp 270.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" }
    ]} />

</Layout>
