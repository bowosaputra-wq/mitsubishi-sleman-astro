---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
---

<Layout title="Harga New Xpander Cross Sleman 2026 | SUV MPV Tangguh – Mitsubishi Sleman" description="Harga terbaru Mitsubishi Xpander Cross di Sleman Yogyakarta 2026. Mesin 1.5L MIVEC, fitur AYC, 6 Airbags, dan desain SUV maskulin. Hubungi Putra Sales Mitsubishi." image="/images/xpander-cross.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Xpander Cross 2026",
      "image": "https://mitsubishi-sleman.online/images/xpander-cross.webp",
      "description": "SUV berkeluarga yang tangguh dengan kenyamanan maksimal dan fitur keselamatan lengkap. Tersedia di Sleman Yogyakarta melalui Putra Sales.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "New Xpander Cross Premium CVT",
          "priceCurrency": "IDR",
          "price": "377500000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "New Xpander Cross MT",
          "priceCurrency": "IDR",
          "price": "350000000",
          "availability": "https://schema.org/InStock"
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "New Xpander Cross" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Xpander Cross Sleman 2026</h1>
        <p>Rise to Your Adventure. Perpaduan sempurna antara ketangguhan SUV dan fungsionalitas MPV untuk keluarga petualang.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/xpander-cross.webp" alt="Mitsubishi Xpander Cross Premium 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian Xpander Cross -->
            <div class="product-card">
                <h2>Harga Xpander Cross Sleman 2026</h2>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian Cross</th>
                            <th>Transmisi</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background: #fff5f5;">
                            <td><strong>Premium Package</strong></td>
                            <td>CVT</td>
                            <td class="price-col"><strong>Rp 377.500.000</strong></td>
                        </tr>
                        <tr>
                            <td>Standar Cross</td>
                            <td>MT</td>
                            <td class="price-col">Rp 350.000.000</td>
                        </tr>
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo DP mulai 10% & bunga ringan. Hubungi Putra untuk hitungan pasti!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Canggihnya Fitur Xpander Cross</h2>
                <table class="spec-table">
                    <tr><th>Dimensi</th><td>4.595 x 1.790 x 1.750 mm</td></tr>
                    <tr><th>Mesin</th><td>1.5L MIVEC DOHC 16 Valve, 1.499 cc</td></tr>
                    <tr><th>Tenaga Maks</th><td>105 PS (77 kW) @ 6.000 rpm</td></tr>
                    <tr><th>Torsi Maks</th><td>141 Nm @ 4.000 rpm</td></tr>
                    <tr><th>Transmisi</th><td>CVT (Lancar) / 5-Speed Manual</td></tr>
                    <tr><th>Ground Clearance</th><td>225 mm (SUV Class)</td></tr>
                    <tr><th>Multimedia</th><td>8" LCD Meter Cluster & 10" Touchscreen</td></tr>
                    <tr><th>Keselamatan</th><td>Active Yaw Control (AYC), 6 SRS Airbags, ASC, HSA</td></tr>
                    <tr><th>Eksterior</th><td>LED Projector Headlamp, Roof Rail, Wheel Arch Molding</td></tr>
                    <tr><th>Interior</th><td>Dua-nada Warna (Black & Burgundy), Wireless Charger</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">Active Yaw Control (AYC)</span>
                    <span class="feature-pill">6 SRS Airbags</span>
                    <span class="feature-pill">8" LCD Meter Cluster</span>
                    <span class="feature-pill">10" Touchscreen & Smartphone Link</span>
                    <span class="feature-pill">Wireless Charger</span>
                    <span class="feature-pill">Electric Parking Brake</span>
                    <span class="feature-pill">Roof Rail</span>
                    <span class="feature-pill">High Ground Clearance 225mm</span>
                </div>
            </div>

            <!-- Color Options -->
            <div class="product-card">
                <h2>Pilihan Warna Xpander Cross</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 1rem;">
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #4b5320; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Green Bronze Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Quartz White Pearl</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #e9ecef; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Blade Silver Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #212529; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Jet Black Mica</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #6c757d; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Graphite Gray Met.</p>
                    </div>
                </div>
                <p style="font-size: 0.75rem; color: var(--m-mid-grey); margin-top: 10px;">* Pilihan warna elegan untuk jiwa petualang. Hubungi Putra untuk cek unit ready.</p>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit Xpander Cross Sleman</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit New Xpander Cross MT (OTR Rp 350.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 70 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 8,6 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 6,4 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo DP Ringan</div>
                        <div class="k-value">Mulai 10%</div>
                        <div class="k-sub">Hubungi Marketing</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti & nego diskon maksimal.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Ketangguhan Xpander Cross di Segala Medan</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🔥 Karakter SUV Sejati</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Desain bumper tangguh, roof rail, dan over fender yang memberikan tampilan maskulin dan siap diajak ke manapun.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛠️ Active Yaw Control (AYC)</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Fitur handling tercanggih di kelasnya yang membantu mobil tetap stabil dan presisi saat bermanuver di tikungan tajam atau kondisi jalan basah.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛋️ Kabin Luas & Kedap</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Mempertahankan kemewahan Xpander dengan tambahan kekedapan suara terbaik, menjaga kenyamanan keluarga dalam perjalanan jarak jauh.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🌲 Petualangan Keluarga Jogja</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Ground clearance 225 mm sangat ideal untuk menjelajah area wisata petualangan di Yogyakarta mulai dari pantai hingga lereng Merapi.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/xpander-cross.webp"
                imageAlt="Xpander Cross"
                price="Rp 350 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20Xpander%20Cross%20di%20Sleman.%20Boleh%20minta%20info%20promonya%3F"
                waButtonText="Tanya Promo Cross"
                ctaId="wa-xpander-cross-cta"
                features={["Test Drive Door to Door", "Teknologi AYC", "SUV-Family No. 1"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-sleman.html">→ New Xpander Sleman</a></li>
                    <li><a href="/pajero-sport-sleman.html">→ Pajero Sport Sleman</a></li>
                    <li><a href="/destinator-sleman.html">→ Mitsubishi Destinator</a></li>
                    <li><a href="/xforce-jogja.html">→ Xforce Jogja</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                    <li><a href="/blog/perbandingan-xpander-vs-xforce.html">Xpander vs Xforce</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Xpander – MPV Pilihan", price: "Mulai Rp 276.000.000", image: "/images/xpander.webp", alt: "Xpander Sleman", href: "/xpander-sleman.html" },
        { title: "Mitsubishi Destinator – Premium SUV", price: "Mulai Rp 400.000.000", image: "/images/destinator.webp", alt: "Destinator Sleman", href: "/destinator-sleman.html" },
        { title: "Pajero Sport – Promo", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" },
        { title: "New Colt L300 – Jagonya Cuan", price: "Rp 270.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" }
    ]} />

</Layout>
