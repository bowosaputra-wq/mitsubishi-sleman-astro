---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import carsData from '../data/cars.json';

const car = carsData.cars.find(c => c.id === 'xforce');
const variants = car?.variants || [];

const productSchema = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Mitsubishi XForce 2026',
    image: 'https://mitsubishi-sleman.online/images/xforce.webp',
    description: 'Compact SUV premium dengan desain futuristik, audio Yamaha, dan fitur keselamatan Diamond Sense. Tersedia di Sleman Yogyakarta melalui Putra Sales.',
    brand: { '@type': 'Brand', name: 'Mitsubishi' },
    offers: variants.map((v) => ({
        '@type': 'Offer',
        name: `${v.name} ${v.transmission}`,
        priceCurrency: 'IDR',
        price: v.price.replace(/\D/g, ''),
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'AutoDealer', name: 'Mitsubishi Sleman – Putra Sales', url: 'https://mitsubishi-sleman.online' }
    }))
};

const xforceFaq = [
    {
        q: "Apa bedanya Xforce HEV dengan Xforce bensin biasa?",
        a: "Xforce HEV menggunakan teknologi hybrid — kombinasi mesin bensin dan motor listrik — sehingga lebih irit bahan bakar untuk pemakaian harian. Tidak perlu colok listrik: baterai hybrid mengisi sendiri saat mobil dikendarai."
    },
    {
        q: "Berapa DP minimal kredit Xforce di Jogja?",
        a: "Promo DP ringan mulai 15% dari harga OTR Yogyakarta. Hubungi Putra via WhatsApp untuk simulasi cicilan pasti sesuai tenor dan profil pengajuan Anda."
    },
    {
        q: "Apakah bisa test drive Xforce ke rumah?",
        a: "Bisa. Layanan test drive door to door tersedia untuk area Sleman dan Yogyakarta pada unit dan jadwal tertentu, termasuk untuk varian HEV."
    },
    {
        q: "KTP luar Jogja apakah bisa proses kredit?",
        a: "Bisa. Kami melayani pengajuan kredit untuk KTP Jogja dan Jawa Tengah. Konsultasikan dokumen Anda — tim kami bantu sampai approve."
    },
    {
        q: "Apakah unit Xforce ready stock atau inden?",
        a: "Varian dan warna populer umumnya ready stock. Untuk varian HEV dan warna tertentu bisa inden — hubungi Putra untuk cek stok terbaru di Sleman sebelum Anda datang."
    },
    {
        q: "Pilih Xforce atau Xpander?",
        a: "Pilih Xforce jika menginginkan SUV compact yang stylish dengan fitur premium seperti Yamaha Sound dan Diamond Sense. Pilih Xpander jika butuh MPV 7-penumpang untuk keluarga besar. Baca artikel perbandingan Xpander vs Xforce di blog kami."
    }
];

const xforceFaqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: xforceFaq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
};
---

<Layout title="Harga Xforce Jogja 2026 | SUV Compact Terbaik – Mitsubishi Sleman" description="Harga dan promo Mitsubishi Xforce terbaru di Jogja &amp; Sleman 2026, termasuk varian hybrid Xforce HEV. Audio Yamaha Premium, sunroof, kredit mudah. Test drive door to door. Hubungi Putra Sales Mitsubishi." image="/images/xforce.webp">
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(xforceFaqSchema)} />
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Xforce Jogja" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Xforce Jogja 2026</h1>
        <p>SUV Compact Paling Stylish. Promo DP Rendah &amp; Kredit Cepat se-Yogyakarta. Bawa Pulang XForce Impianmu!</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/xforce.webp" alt="Mitsubishi Xforce Ultimate 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian -->
            <div class="product-card">
                <h2>Harga Xforce Jogja 2026</h2>
                <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.6; margin-bottom: 1rem;">Xforce 2026 kini tersedia dalam 5 varian — 3 bensin dan 2 hybrid (HEV). Semua harga di bawah ini adalah OTR Yogyakarta dan dapat berubah mengikuti promo bulan berjalan.</p>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian</th>
                            <th>Transmisi</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants.map((v) => (
                            <tr style={v.name === "Xforce HEV Premium" ? "background: #fff5f5;" : undefined}>
                                <td>{v.name === "Xforce HEV Premium" ? <strong>{v.name}</strong> : v.name}</td>
                                <td>{v.transmission}</td>
                                <td class="price-col">
                                    {v.name === "Xforce HEV Premium" ? <strong>{v.price}</strong> : v.price}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo tambahan &amp; diskon akhir tahun? Langsung chat/telepon Putra!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Canggihnya Fitur Xforce</h2>
                <table class="spec-table">
                    <tr><th>Dimensi</th><td>4.390 x 1.810 x 1.660 mm</td></tr>
                    <tr><th>Mesin</th><td>4A91 1.5L MIVEC DOHC 16 Valve, 1.499 cc</td></tr>
                    <tr><th>Tenaga Maks</th><td>105 PS (77 kW) @ 6.000 rpm</td></tr>
                    <tr><th>Torsi Maks</th><td>141 Nm @ 4.000 rpm</td></tr>
                    <tr><th>Transmisi</th><td>CVT (Continuously Variable Transmission)</td></tr>
                    <tr><th>Mode Berkendara</th><td>Normal, Wet, Gravel, Mud (Tipe Ultimate)</td></tr>
                    <tr><th>Audio</th><td>Yamaha Premium Sound (8 Speaker) - Ultimate</td></tr>
                    <tr><th>Head Unit / MID</th><td>12.3" Smartphone-link / 8" Digital Display</td></tr>
                    <tr><th>Ground Clearance</th><td>222 mm (Tertinggi di kelasnya!)</td></tr>
                    <tr><th>Keselamatan</th><td>Diamond Sense (ADAS), HSA, ASC, AYC, TPMS</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">Diamond Sense (ADAS)</span>
                    <span class="feature-pill">Yamaha Sound System</span>
                    <span class="feature-pill">Screen 12.3" & 8" Digital</span>
                    <span class="feature-pill">4 Drive Modes</span>
                    <span class="feature-pill">Power Tailgate + Kick Sensor</span>
                    <span class="feature-pill">Dual Zone AC + NanoeX</span>
                    <span class="feature-pill">Wireless Charger</span>
                    <span class="feature-pill">Active Yaw Control (AYC)</span>
                </div>
            </div>

            <!-- Color Options -->
            <div class="product-card">
                <h2>Pilihan Warna Xforce</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 1rem;">
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Quartz White Pearl</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #e9ecef; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Blade Silver Metallic</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #ffc107; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Energetic Yellow</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #dc3545; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Red Metallic</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #6c757d; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Graphite Gray</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #212529; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Jet Black Mica</p>
                    </div>
                </div>
                <p style="font-size: 0.75rem; color: var(--m-mid-grey); margin-top: 10px;">* Opsi Two-tone tersedia eksklusif pada varian Ultimate Premium.</p>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit Xforce Jogja</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit Xforce Ultimate CVT (OTR Rp 339.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 67,8 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 8,2 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 6,0 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo DP Ringan</div>
                        <div class="k-value">Mulai 15%</div>
                        <div class="k-sub">Silakan Konsultasi</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti &amp; nego diskon maksimal.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Kenapa Xforce Cocok untuk Jogja?</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🎵 Yamaha Premium Sound</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kualitas audio kelas konser dengan 8-speaker. Membuat kemacetan di area Malioboro atau Gejayan tetap terasa menyenangkan.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛣️ Diamond Sense (ADAS)</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Fitur keselamatan pintar (ACC, FCM, BSW) yang menjaga Anda tetap aman dan rileks saat berkendara di Ring Road Yogyakarta.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🏔️ 4 Mode Berkendara</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Mode Normal, Wet, Gravel, & Mud. Fleksibel untuk menjelajah pantai Gunungkidul hingga perbukitan Kaliurang dengan stabil.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🌊 Ground Clearance 222mm</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Tertinggi di kelasnya. Memberikan rasa tenang saat melewati genangan air hujan atau jalan bergelombang di sekitar Sleman.</p>
                    </div>
                </div>
            </div>

            <!-- Apa Itu Xforce HEV -->
            <div class="product-card">
                <h2>Apa Itu Xforce HEV?</h2>
                <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.6;">HEV adalah singkatan dari <strong>Hybrid Electric Vehicle</strong>. Xforce HEV menggabungkan mesin bensin dengan motor listrik — hasilnya tarikan tetap responsif tapi konsumsi BBM jauh lebih irit, ideal untuk pemakaian harian dalam kota seperti Jogja.</p>
                <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.6; margin-top: 0.6rem;">Yang penting: <strong>tidak perlu colok listrik</strong>. Baterai hybrid mengisi daya sendiri saat mobil dikendarai, termasuk saat pengereman. Jadi tidak ada kebiasaan baru yang perlu diubah — isi bensin seperti biasa, sisanya diatur otomatis oleh sistem hybrid.</p>
            </div>

            <!-- Panduan Memilih Varian -->
            <div class="product-card">
                <h2>Panduan Memilih Varian Xforce</h2>
                <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.6;">Lima varian, lima karakter. Pilih berdasarkan prioritas Anda:</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">💰 Ultimate — Paling Terjangkau</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Rp 339 juta. Titik masuk paling hemat untuk merasakan Xforce — cocok jika budget adalah prioritas utama.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">⚖️ Exceed — Naik Kelas</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Rp 388 juta. Satu tingkat di atas untuk kelengkapan fitur yang lebih baik — konsultasikan selisih fiturnya dengan Putra.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🎨 Ultimate Premium — Paling Stylish</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Rp 424 juta. Satu-satunya varian dengan opsi warna two-tone eksklusif — untuk yang mengutamakan tampilan.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🌿 HEV — Hybrid Paling Efisien</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Rp 445 juta. Untuk yang mengutamakan irit BBM — teknologi hybrid bensin + listrik tanpa perlu ngecas.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">👑 HEV Premium — Flagship</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Rp 470 juta. Kasta tertinggi Xforce: efisiensi hybrid dipadukan dengan fitur terlengkap.</p>
                    </div>
                </div>
            </div>

            <!-- Kelebihan & Pertimbangan -->
            <div class="product-card">
                <h2>Kelebihan & Hal yang Perlu Dipertimbangkan</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: #2b8a3e; font-weight: bold; margin-bottom: 8px;">✅ Kelebihan</div>
                        <ul style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.7; padding-left: 1.1rem; margin: 0;">
                            <li>Yamaha Premium Sound 8-speaker — hiburan kelas konser</li>
                            <li>Diamond Sense (ADAS) untuk keselamatan aktif</li>
                            <li>Ground clearance 222 mm, tertinggi di kelasnya</li>
                            <li>4 mode berkendara: Normal, Wet, Gravel, Mud</li>
                            <li>Kini ada pilihan hybrid (HEV) yang lebih irit</li>
                        </ul>
                    </div>
                    <div>
                        <div style="color: #e67700; font-weight: bold; margin-bottom: 8px;">⚖️ Perlu Dipertimbangkan</div>
                        <ul style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.7; padding-left: 1.1rem; margin: 0;">
                            <li>Varian HEV lebih mahal ±Rp 21–46 juta dari padanan bensinnya — sesuaikan dengan jarak tempuh harian agar penghematan BBM terasa</li>
                            <li>Rentang harga lebar (Rp 339–470 juta) — tentukan budget dan prioritas (gaya, fitur, atau irit) sebelum memilih varian</li>
                            <li>Opsi warna two-tone hanya tersedia di Ultimate Premium</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- FAQ Xforce -->
            <div class="product-card">
                <h2>Pertanyaan Umum tentang Xforce di Jogja</h2>
                <div style="margin-top: 1rem;">
                    {xforceFaq.map((item) => (
                        <div style="margin-bottom: 1.1rem;">
                            <h3 style="font-size: 1rem; margin-bottom: 0.35rem;">{item.q}</h3>
                            <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.6; margin: 0;">{item.a}</p>
                        </div>
                    ))}
                </div>
                <p style="font-size: 0.85rem; color: var(--m-mid-grey); margin-top: 0.5rem;">Ada pertanyaan lain? <a href="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20mau%20tanya%20tentang%20Xforce." target="_blank" rel="noopener">Chat Putra langsung via WhatsApp</a> — fast respon.</p>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/xforce.webp"
                imageAlt="Xforce"
                price="Rp 339 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20Boleh%20minta%20brosur%20dan%20harga%20promo%20Xforce%20di%20Jogja%3F"
                waButtonText="Tanya Promo Xforce"
                ctaId="wa-xforce-cta"
                features={["Test Drive Door to Door", "Audio Yamaha Premium", "Unit Ready Stock!"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-sleman.html">→ New Xpander Sleman</a></li>
                    <li><a href="/xpander-cross-sleman.html">→ New Xpander Cross</a></li>
                    <li><a href="/pajero-sport-sleman.html">→ Pajero Sport Sleman</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/perbandingan-xpander-vs-xforce.html">Baca: Xpander vs Xforce</a></li>
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related -->
    <RelatedProducts products={[
        { title: "Mitsubishi Destinator – Premium SUV", price: "Mulai Rp 400.000.000", image: "/images/destinator.webp", alt: "Destinator Sleman", href: "/destinator-sleman.html" },
        { title: "New Xpander Cross – SUV MPV", price: "Rp 377.500.000", image: "/images/xpander-cross.webp", alt: "Xpander Cross Sleman", href: "/xpander-cross-sleman.html" },
        { title: "New Colt L300 – Pikap Legendaris", price: "Rp 270.000.000", image: "/images/l300.webp", alt: "Colt L300 Sleman", href: "/l300-sleman.html" },
        { title: "Pajero Sport – Promo", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" }
    ]} />

    
</Layout>
