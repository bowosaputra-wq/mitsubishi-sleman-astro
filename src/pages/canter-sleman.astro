---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
---

<Layout title="Harga Truk Canter Sleman 2026 | Dealer Mitsubishi Fuso Jogja" description="Harga terbaru truk Mitsubishi Canter (Colt Diesel) 4 ban dan 6 ban di Sleman Yogyakarta. Mesin EURO 4 tangguh, irit, jagonya angkutan bisnis." image="/images/canter.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Canter (Colt Diesel) 2026",
      "image": "https://mitsubishi-sleman.online/images/canter.webp",
      "description": "Truk andalan bisnis Indonesia. Tersedia pilihan 4 ban (Engkel) dan 6 ban (Double) dengan mesin EURO 4 yang tangguh dan irit.",
      "brand": { "@type": "Brand", "name": "Mitsubishi Fuso" },
      "offers": [
        {
          "@type": "Offer",
          "name": "Canter FE 71 (4 Ban)",
          "priceCurrency": "IDR",
          "price": "395000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Canter" }
]} />

    <div class="page-hero" style="background: linear-gradient(135deg, #111 0%, #442200 100%);">
        <h1 style="color: #fceb00;">Harga Mitsubishi Canter Sleman 2026</h1>
        <p>Legenda "Si Kepala Kuning". Kini lebih tangguh, efisien, dan ramah lingkungan dengan standar mesin EURO 4. Andalan nomor 1 bisnis Anda.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <!-- Gunakan gambar Canter -->
            <img src="/images/canter.webp" alt="Truk Mitsubishi Canter Euro 4 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian Canter -->
            <div class="product-card">
                <h2>Harga Canter Sleman (Cabin Chassis) 2026</h2>
                <p style="font-size: 0.9rem; color: var(--m-mid-grey); margin-bottom: 1rem;">* Harga OTR DIY / Jawa Tengah. Harga Chassis (Belum termasuk Bak/Box/Dump). Hubungi untuk penawaran karoseri lengkap.</p>
                
                <!-- TABEL 4 BAN -->
                <h3 style="background: #f8f9fa; padding: 10px 15px; border-left: 4px solid var(--m-red); font-size: 1.1rem; margin-top: 1rem;">Varian 4 Ban (Engkel)</h3>
                <table class="price-table" style="margin-top: 0.5rem;">
                    <thead>
                        <tr>
                            <th>Tipe Canter</th>
                            <th>Tenaga (PS)</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>FE 71</strong> (Standard)</td>
                            <td>108 PS</td>
                            <td class="price-col">Rp 395.000.000</td>
                        </tr>
                        <tr>
                            <td><strong>FE 71 Long</strong> (Sasis Panjang)</td>
                            <td>108 PS</td>
                            <td class="price-col">Rp 408.000.000</td>
                        </tr>
                    </tbody>
                </table>

                <!-- TABEL 6 BAN -->
                <h3 style="background: #f8f9fa; padding: 10px 15px; border-left: 4px solid var(--m-red); font-size: 1.1rem; margin-top: 2rem;">Varian 6 Ban (Double)</h3>
                <table class="price-table" style="margin-top: 0.5rem;">
                    <thead>
                        <tr>
                            <th>Tipe Canter</th>
                            <th>Tenaga (PS)</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>FE 74</strong> (Super Speed)</td>
                            <td>136 PS</td>
                            <td class="price-col">Rp 445.000.000</td>
                        </tr>
                        <tr>
                            <td><strong>FE 74 Long</strong> (Kargo Ekspedisi)</td>
                            <td>136 PS</td>
                            <td class="price-col">Rp 460.000.000</td>
                        </tr>
                        <tr style="background: #fff5f5;">
                            <td><strong>FE 74 HD</strong> (Heavy Duty / Dump)</td>
                            <td>136 PS</td>
                            <td class="price-col"><strong>Rp 455.000.000</strong></td>
                        </tr>
                        <tr style="background: #fff5f5;">
                            <td><strong>FE SHDX</strong> (Super Heavy Duty)</td>
                            <td>136 PS</td>
                            <td class="price-col"><strong>Rp 468.000.000</strong></td>
                        </tr>
                        <tr>
                            <td><strong>FE 84 G</strong> (Lebar Maksimal)</td>
                            <td>150 PS</td>
                            <td class="price-col">Rp 480.000.000</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- PERBANDINGAN FUNGSI TRUK (4 BAN VS 6 BAN) -->
            <div class="product-card">
                <h2>Panduan Memilih Varian Canter</h2>
                <p style="font-size: 0.95rem; color: var(--m-mid-grey); margin-bottom: 1.5rem;">Pilih sasis truk yang paling tepat untuk jenis usaha dan medan operasional Anda (Karoseri bisa disesuaikan).</p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                    
                    <!-- Card 4 Ban -->
                    <div style="border: 1px solid #111; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.08);">
                        <div style="background: #111; color: #fceb00; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">TRUK 4 BAN (ENGKEL) - FE 71 Series</div>
                        <div style="padding: 1.5rem; background: #fff;">
                            <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px;"><strong>Kelincahan Maksimal Dalam Kota.</strong><br>Cocok untuk jalan-jalan kecil, pemukiman, dan regulasi kota yang melarang truk besar.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>BBE/GVW:</strong> 5.150 Kg</li>
                                <li><strong>Pilihan Karoseri Terbaik:</strong> Box Alumunium, Box Pendingin (Freezer), Bak Kayu Standard.</li>
                                <li><strong>Cocok Untuk Usaha:</strong> Distribusi Minimized/Retail, Frozen Food, Jasa Angkut Pindahan.</li>
                                <li>Fitur <strong>FE 71 Long</strong> memungkinkankan volume kargo lebih besar tanpa melanggar regulasi 4 ban.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 6 Ban Standar -->
                    <div style="border: 1px solid #cce5ff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.08);">
                        <div style="background: #0056b3; color: #ffffff; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">TRUK 6 BAN (CARGO) - FE 74 & FE 84</div>
                        <div style="padding: 1.5rem; background: #f8fbff;">
                            <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px;"><strong>Volume Besar Lintas Kota/Provinsi.</strong><br>Didesain untuk kecepatan jalan raya tol (Super Speed) dengan sasis super panjang.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>BBE/GVW:</strong> 7.500 Kg - 8.000 Kg</li>
                                <li><strong>Pilihan Karoseri Terbaik:</strong> Bak Besi, Bak Kayu, Wingbox, Tangki Cairan.</li>
                                <li><strong>Cocok Untuk Usaha:</strong> Ekspedisi Logistik Lintas Jawa, Pengiriman Minuman, Hasil Pertanian.</li>
                                <li><strong>FE 84 G</strong> adalah varian paling lebar dan tenaga terbesar (150 PS) di kelasnya.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 6 Ban Heavy Duty -->
                    <div style="border: 1px solid #ffcccc; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.08);">
                        <div style="background: var(--m-red); color: #ffffff; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">TRUK 6 BAN (HEAVY DUTY) - FE 74 HD / SHDX</div>
                        <div style="padding: 1.5rem; background: #fff5f5;">
                            <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px;"><strong>Raja Tanjakan & Torsi Badak.</strong><br>Memiliki rasio gardan (Final Gear) lebih besar sehingga torsinya berlipat ganda di jalanan menanjak / berlumpur.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>BBE/GVW:</strong> 7.500 Kg - 8.200 Kg</li>
                                <li><strong>Pilihan Karoseri Terbaik:</strong> Dump Truck, Bak Kayu Tinggi.</li>
                                <li><strong>Cocok Untuk Usaha:</strong> Material Bangunan, Pasir Merapi, Tambang, Sawit, Perhutani.</li>
                                <li><strong>FE SHDX</strong> menggunakan gardan super besar, mampu disiksa di medan off-road Jogja/Jateng.</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Kenapa Harus Pilih Fuso Canter Euro 4?</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🔧 Mesin Tangguh & Irit</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Perpaduan teknologi mesin 4V21 Common Rail dan Exhaust Gas Recirculation (EGR) menjadikannya bertenaga besar tanpa memboroskan bahan bakar.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">📞 Runner Telematic System</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Dilengkapi GPS cerdas bawaan pabrik. Anda bisa pantau letak truk, sisa bbm, dan cara mengemudi supir dari HP secara real-time kapan pun.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛠️ Purna Jual Nomor 1</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Lebih dari 400 dealer/bengkel Fuso tersebar di penjuru Indonesia dan nilai harga jual kembali (resale value) paling tinggi.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <!-- Sidebar CTA dengan warna dark -->
            <SidebarCTA
                image="/images/canter.webp"
                imageAlt="Mitsubishi Canter"
                price="Mulai Rp 395 Jt"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20tambah%20armada%20truk%20Canter.%20Bisa%20bantu%20simulasi%20dp%20%26%20karoserinya%3F"
                waButtonText="Tanya Diskon Canter"
                ctaId="wa-canter-cta"
                features={["Gratis GPS Runner", "Paket Termasuk Karoseri", "Bunga Kredit Niaga Murah"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Kendaraan Niaga Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/l300-sleman.html">→ New Colt L300</a></li>
                    <li><a href="/triton-sleman.html">→ New Triton 4x4</a></li>
                    <li><a href="/fuso-fighter-sleman.html">→ Fuso Fighter X</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Layanan Pembelian Truk</h3>
                <p style="font-size: 0.85rem; color: var(--m-mid-grey); margin-top: 8px;">Kami melayani pembuatan berbagai macam bentuk karoseri (Box, Bak, Dump, Tangki) yang memiliki sertifikat uji KIR berstandar nasional.</p>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Colt L300", price: "Mulai Rp 230.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" },
        { title: "Fuso Fighter X", price: "Hubungi Sales", image: "/images/fuso-fighter.webp", alt: "Fuso Fighter Sleman", href: "/fuso-fighter-sleman.html" },
        { title: "New Triton", price: "Mulai Rp 295.000.000", image: "/images/triton.webp", alt: "Triton Sleman", href: "/triton-sleman.html" }
    ]} />

</Layout>
