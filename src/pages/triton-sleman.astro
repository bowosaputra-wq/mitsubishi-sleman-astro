---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
---

<Layout title="Harga New Triton Sleman 2026 | Kendaraan Niaga 4x4 Tangguh" description="Harga terbaru Mitsubishi New Triton di Sleman Yogyakarta 2026. Pick up 4x4 paling tangguh untuk pertambangan dan perkebunan. Hubungi Putra Sales Mitsubishi." image="/images/triton.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi New Triton 2026",
      "image": "https://mitsubishi-sleman.online/images/triton.webp",
      "description": "Kendaraan double cabin & single cabin 4x4 paling diandalkan untuk bisnis, pertambangan, dan offroad di Sleman Yogyakarta.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "New Triton Single Cab 4x2 MT",
          "priceCurrency": "IDR",
          "price": "295000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Triton" }
]} />

    <div class="page-hero">
        <h1>Harga New Triton Sleman 2026</h1>
        <p>Engineered Beyond Tough. Tenaga buas, ketangguhan 4x4 legendaris, dan durabilitas tinggi untuk memajukan bisnis Anda.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/triton.webp" alt="Mitsubishi New Triton 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian Triton -->
            <div class="product-card">
                <h2>Harga New Triton Sleman 2026</h2>
                <p style="font-size: 0.9rem; color: var(--m-mid-grey); margin-bottom: 1rem;">* Harga OTR DIY (Belum termasuk diskon / cashback). Hubungi Putra untuk harga nett.</p>
                
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian Triton (Tipe)</th>
                            <th>Transmisi & Penggerak</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background: #fff5f5;">
                            <td><strong>Ultimate Double Cab</strong></td>
                            <td>AT (4x4)</td>
                            <td class="price-col"><strong>Rp 520.000.000</strong></td>
                        </tr>
                        <tr>
                            <td>Exceed Double Cab</td>
                            <td>MT (4x4)</td>
                            <td class="price-col">Rp 485.000.000</td>
                        </tr>
                        <tr>
                            <td>GLS Double Cab</td>
                            <td>MT (4x4)</td>
                            <td class="price-col">Rp 440.000.000</td>
                        </tr>
                        <tr style="background: #f0f7ff;">
                            <td><strong>HDX Double Cab</strong></td>
                            <td>MT (4x4)</td>
                            <td class="price-col"><strong>Rp 425.000.000</strong></td>
                        </tr>
                        <tr>
                            <td>HDX Single Cab</td>
                            <td>MT (4x4)</td>
                            <td class="price-col">Rp 375.000.000</td>
                        </tr>
                        <tr>
                            <td>GLX Single Cab</td>
                            <td>MT (4x2)</td>
                            <td class="price-col">Rp 295.000.000</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- PERBANDINGAN VARIAN (NILAI JUAL UTAMA UNTUK COMMERCIAL VECHILE) -->
            <div class="product-card">
                <h2>Highlight Perbedaan Varian Triton</h2>
                <p style="font-size: 0.95rem; color: var(--m-mid-grey); margin-bottom: 1.5rem;">Pilih spesifikasi yang paling tepat untuk kebutuhan operasional bisnis Anda.</p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                    
                    <!-- Card 1 -->
                    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                        <h3 style="color: var(--m-red); margin-bottom: 8px; font-size: 1.1rem;">Tipe ULTIMATE (Double Cab)</h3>
                        <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px; font-weight: bold;">Kendaraan Operasional Petinggi / Pribadi</p>
                        <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                            <li>Transmisi Otomatis (AT) 6-Speed</li>
                            <li>Super Select 4WD-II (Mode Offroad Pintar)</li>
                            <li>Interior Mewah (Leather Seat)</li>
                            <li>Sistem Keamanan Aktif (FCM, BSW, UMS)</li>
                        </ul>
                    </div>

                    <!-- Card 2 -->
                    <div style="border: 1px solid #cce5ff; border-radius: 8px; padding: 1.5rem; background: #f8fbff; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                        <h3 style="color: #0056b3; margin-bottom: 8px; font-size: 1.1rem;">Tipe HDX (Double & Single Cab)</h3>
                        <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px; font-weight: bold;">Workhorse (Pekerja Keras) Pertambangan</p>
                        <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                            <li>Transmisi Manual 5-Speed</li>
                            <li>Easy Select 4WD</li>
                            <li>Suspensi Heavy Duty (Mampu angkut berat)</li>
                            <li>Fitur basic & tangguh, mudah dirawat di site</li>
                        </ul>
                    </div>

                    <!-- Card 3 -->
                    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                        <h3 style="color: var(--m-dark-grey); margin-bottom: 8px; font-size: 1.1rem;">Tipe GLX 4x2 (Single Cab)</h3>
                        <p style="font-size: 0.85rem; color: #555; margin-bottom: 12px; font-weight: bold;">Kendaraan Niaga & Angkutan Dalam Kota</p>
                        <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                            <li>Penggerak Belakang 4x2 (Bukan untuk Offroad)</li>
                            <li>Bak Kargo Lebih Luas & Panjang</li>
                            <li>Konsumsi BBM Sangat Irit</li>
                            <li>Cocok untuk Perkebunan Ringan, Material, Cargo</li>
                        </ul>
                    </div>

                </div>
            </div>

            <!-- Spesifikasi Dasar -->
            <div class="product-card">
                <h2>Spesifikasi Dasar New Triton</h2>
                <table class="spec-table">
                    <tr><th>Mesin Utama</th><td>2.4L 4N15 DI-D Common Rail Turbocharger</td></tr>
                    <tr><th>Tenaga Maks</th><td>181 PS @ 3.500 rpm (VGT) / 136 PS (Non-VGT)</td></tr>
                    <tr><th>Torsi Maks</th><td>430 Nm @ 2.500 rpm (VGT)</td></tr>
                    <tr><th>Ground Clearance</th><td>220 mm (Sangat tinggi untuk banjir / lumpur)</td></tr>
                    <tr><th>Kapasitas Tangki</th><td>75 Liter Diesel</td></tr>
                    <tr><th>Kapasitas Towing</th><td>Hingga 3,1 Ton (Tipe Ultimate/Exceed)</td></tr>
                    <tr><th>Perlindungan Sasis</th><td>RISE Body (Reinforced Impact Safety Evolution)</td></tr>
                </table>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Mengapa Bisnis Anda Membutuhkan Triton?</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">💪 Mesin Diesel MIVEC Torsi Monster</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Menghasilkan tenaga 181 PS yang sangat kuat untuk menarik beban berat di tanjakan berlumpur tanpa ngeden.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">⛰️ Super Select 4WD-II</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Anda bisa memindahkan mode dari 2H ke 4H saat melaju. Memberikan traksi maksimum di permukaan batu, pasir, dan lumpur.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🔧 Perawatan Terjamin di Pelosok</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Ketersediaan sparepart dan bengkel Mitsubishi sangat mudah dijangkau di seluruh wilayah Sleman, Jogja, hingga pelosok Jawa Tengah.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/triton.webp"
                imageAlt="New Triton"
                price="Mulai Rp 295 Jt"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20Triton%20untuk%20operasional%20bisnis.%20Bisa%20minta%20info%20diskon%20fleet%3F"
                waButtonText="Tanya Diskon Triton"
                ctaId="wa-triton-cta"
                features={["Diskon Fleet/Jumlah Banyak", "Kredit Bunga Rendah", "Sparepart & Servis Mudah"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Kendaraan Niaga Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/l300-sleman.html">→ New Colt L300</a></li>
                    <li><a href="/canter-sleman.html">→ Canter (Colt Diesel)</a></li>
                    <li><a href="/fuso-fighter-sleman.html">→ Fuso Fighter X</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Colt L300", price: "Mulai Rp 230.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" },
        { title: "Canter (Colt Diesel)", price: "Harga On Call", image: "/images/canter.webp", alt: "Canter Sleman", href: "/canter-sleman.html" },
        { title: "Pajero Sport – Premium SUV", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" }
    ]} />

</Layout>
