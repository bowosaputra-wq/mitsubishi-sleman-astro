---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import carsData from '../data/cars.json';

const car = carsData.cars.find(c => c.id === 'fuso-fighter');
const variants4x2 = car?.variants?.filter(v => v.group === '4x2') || [];
const variants6x2 = car?.variants?.filter(v => v.group === '6x2') || [];
const variants6x4 = car?.variants?.filter(v => v.group === '6x4') || [];

const getFusoNameParts = (name) => {
    const parts = name.split(/(\(.*?\))/);
    if (parts.length > 1) {
        return { prefix: parts[0].trim(), suffix: parts[1] };
    }
    return { prefix: name, suffix: "" };
};
---

<Layout title="Harga Truk Fuso Fighter X Sleman 2026 | Medium Duty Truck Tangguh" description="Harga terbaru Mitsubishi Fuso Fighter X 6 ban dan 10 ban di Sleman Yogyakarta 2026. Truk tronton andalan logistik & pertambangan. Hubungi Sales." image="/images/fuso-fighter.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Fuso Fighter X 2026",
      "image": "https://mitsubishi-sleman.online/images/fuso-fighter.webp",
      "description": "Kendaraan Medium Duty Truck (MDT) pilihan para pengusaha Indonesia dengan kabin dinamis, kemampuan gardan besar, dan sasis raksasa.",
      "brand": { "@type": "Brand", "name": "Mitsubishi Fuso" },
      "offers": [
        {
          "@type": "Offer",
          "name": "Fuso Fighter X FM 65 FS (6 Ban)",
          "priceCurrency": "IDR",
          "price": "905000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Fuso Fighter X" }
]} />

    <div class="page-hero" style="background: linear-gradient(135deg, #2b2b2b 0%, #151515 100%);">
        <h1 style="color: #ffffff;">Harga Fuso Fighter X Sleman 2026</h1>
        <p style="color: #cccccc;">Medium Duty Truck Terbaik di Kelasnya. Menjanjikan daya angkut maksimal untuk ekspedisi wingbox hingga operasional dump armada tambang.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/fuso-fighter.webp" alt="Truk Mitsubishi Fuso Fighter X Euro 4 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian Fighter X -->
            <div class="product-card">
                <h2>Harga Fuso Fighter X (Cabin Chassis) 2026</h2>
                <p style="font-size: 0.9rem; color: var(--m-mid-grey); margin-bottom: 1rem;">* Harga Off The Road (Chassis Only). Tersedia karoseri Wingbox, Dump, Tangki, hingga Flatbed untuk wilayah Jateng & DIY.</p>
                
                <!-- TABEL 4x2 (6 BAN) -->
                <h3 style="background: #f4f6f8; padding: 10px 15px; border-left: 4px solid var(--m-red); font-size: 1.1rem; margin-top: 1rem;">Varian 4x2 (6 Ban)</h3>
                <table class="price-table" style="margin-top: 0.5rem;">
                    <thead>
                        <tr>
                            <th>Tipe Truk</th>
                            <th>Tenaga (PS)</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants4x2.map((v) => {
                            const parts = getFusoNameParts(v.name);
                            return (
                                <tr>
                                    <td><strong>{parts.prefix}</strong> {parts.suffix}</td>
                                    <td>{v.transmission}</td>
                                    <td class="price-col">{v.price}</td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>

                <!-- TABEL 6x2 (10 BAN) -->
                <h3 style="background: #f4f6f8; padding: 10px 15px; border-left: 4px solid #0056b3; font-size: 1.1rem; margin-top: 2rem;">Varian 6x2 (10 Ban Tronton)</h3>
                <table class="price-table" style="margin-top: 0.5rem;">
                    <thead>
                        <tr>
                            <th>Tipe Truk</th>
                            <th>Tenaga (PS)</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants6x2.map((v) => {
                            const parts = getFusoNameParts(v.name);
                            return (
                                <tr>
                                    <td><strong>{parts.prefix}</strong> {parts.suffix}</td>
                                    <td>{v.transmission}</td>
                                    <td class="price-col">{v.price}</td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>

                <!-- TABEL 6x4 (10 BAN HD) -->
                <h3 style="background: #f4f6f8; padding: 10px 15px; border-left: 4px solid #212529; font-size: 1.1rem; margin-top: 2rem;">Varian 6x4 & Tractor Head (Heavy Duty)</h3>
                <table class="price-table" style="margin-top: 0.5rem;">
                    <thead>
                        <tr>
                            <th>Tipe Truk</th>
                            <th>Tenaga (PS)</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants6x4.map((v) => {
                            const isHighlighted = v.name.includes("HD");
                            const parts = getFusoNameParts(v.name);
                            return (
                                <tr style={isHighlighted ? "background: #fff5f5;" : undefined}>
                                    <td><strong>{parts.prefix}</strong> {parts.suffix}</td>
                                    <td>{v.transmission}</td>
                                    <td class="price-col">
                                        {isHighlighted ? <strong>{v.price}</strong> : v.price}
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>

            <!-- PERBANDINGAN FUNGSI TRUK (4x2 vs 6x2 vs 6x4) -->
            <div class="product-card">
                <h2>Panduan Kelas & Konfigurasi Fuso Fighter X</h2>
                <p style="font-size: 0.95rem; color: var(--m-mid-grey); margin-bottom: 1.5rem;">Didesain khusus untuk memenuhi regulasi ODOL (Over Dimension Over Load) di jalan raya Indonesia dengan memaksimalkan profit pengusaha.</p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                    
                    <!-- Card 4x2 -->
                    <div style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                        <div style="background: var(--m-red); color: white; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">SERI 4x2 (6 BAN) FM</div>
                        <div style="padding: 1.5rem; background: #fff;">
                            <p style="font-size: 0.85rem; color: #444; margin-bottom: 12px;"><strong>Kelincahan Ekspedisi Menengah</strong><br>Tarikan lincah dengan dimensi sasis yang cukup panjang untuk kebutuhan barang muatan medium.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>Target GVW:</strong> Hingga 16.000 Kg</li>
                                <li><strong>Penggerak:</strong> Roda Belakang (1 Gardan)</li>
                                <li><strong>Aplikasi Karoseri Terbaik:</strong> Wingbox, Bak Kayu, Box Besi, Tangki Air/BBM.</li>
                                <li>Tipe FL (Long) adalah favorit untuk ekspedisi motor lintas provinsi.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 6x2 -->
                    <div style="border: 1px solid #cce5ff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                        <div style="background: #0056b3; color: white; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">SERI 6x2 (10 BAN) FN</div>
                        <div style="padding: 1.5rem; background: #f8fbff;">
                            <p style="font-size: 0.85rem; color: #444; margin-bottom: 12px;"><strong>Raja Volume Logistik Jalan Raya</strong><br>Tronton dengan sasis terpanjang di kelasnya. Cocok untuk muatan sangat panjang namun tidak terlalu berat.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>Target GVW:</strong> Hingga 26.000 Kg</li>
                                <li><strong>Penggerak:</strong> 1 Gardan Belakang, 1 Axis Pasif (Lift/Tandem)</li>
                                <li><strong>Aplikasi Karoseri Terbaik:</strong> Wingbox Panjang, Car Carrier, Box Besi Ekspedisi.</li>
                                <li>Pilihan utama raksasa kurir ekspedisi berkat sasis panjang maksimalnya.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 6x4 -->
                    <div style="border: 1px solid #222; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                        <div style="background: #212529; color: white; padding: 12px 15px; font-weight: bold; font-family: var(--font-heading);">SERI 6x4 & TRACTOR HEAD HD</div>
                        <div style="padding: 1.5rem; background: #fdfdfd;">
                            <p style="font-size: 0.85rem; color: #444; margin-bottom: 12px;"><strong>Monster Area Tambang & Perkebunan</strong><br>Dikawinkan dengan dua gardan belakang aktif, memberikan traksi luar biasa di tanah amblas.</p>
                            <ul style="font-size: 0.85rem; color: var(--m-dark-grey); margin-left: 1rem; line-height: 1.6;">
                                <li><strong>Target GVW/GCW:</strong> 26.000 Kg - 36.000 Kg</li>
                                <li><strong>Penggerak:</strong> 2 Gardan Belakang Aktif (6x4)</li>
                                <li><strong>Aplikasi Karoseri Terbaik:</strong> Dump Truck Indeks Besar, Mixer (Molen), Flatbed Crane, Trailer (TH).</li>
                                <li>Truk andalan untuk penarikan trailer pelabuhan/kontainer ukuran 40 feet.</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Keunggulan Mesin Fuso Fighter X (EURO 4)</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🔧 Mesin Tangguh 6M60</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kualitas mesin 6 silinder legendaris Fuso yang disempurnakan dengan teknologi Variable Geometry Turbo (VGT) khusus EURO 4, dijamin bandel.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛑 Full Air Brakes + ABS</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Pengereman udara penuh yang memastikan truk bisa berhenti seketika meski dengan muatan terberat sekalipun, didukung sistem Anti-lock Braking System.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛋️ Kenyamanan Kabin Eropa</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kabin dilengkapi dengan sistem suspensi udara pada kursi pengemudi, meminimalisir guncangan fatal dan rasa letih supir untuk operasional 24 jam.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/fuso-fighter.webp"
                imageAlt="Fuso Fighter X"
                price="Mulai Rp 905 Jt"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20butuh%20truk%20Fuso%2010%20ban%20untuk%20ekspedisi.%20Bisa%20kasih%20penawaran%3F"
                waButtonText="Minta Penawaran Fuso"
                ctaId="wa-fuso-cta"
                features={["Gratis GPS & Telematika", "Diskon Pembelian Fleet", "Garansi Bengkel Resmi"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Kendaraan Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/canter-sleman.html">→ Canter (Colt Diesel)</a></li>
                    <li><a href="/triton-sleman.html">→ New Triton Sleman</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Pembelian Truk Perusahaan (B2B)</h3>
                <p style="font-size: 0.85rem; color: var(--m-mid-grey); margin-top: 8px;">Kami memahami kebutuhan pengadaan lelang/tender perusahaan Anda. Hubungi kami untuk harga dan skema kredit COP (Car Ownership Program).</p>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "Canter (Colt Diesel)", price: "Harga On Call", image: "/images/canter.webp", alt: "Canter Sleman", href: "/canter-sleman.html" },
        { title: "New Triton", price: "Mulai Rp 295.000.000", image: "/images/triton.webp", alt: "Triton Sleman", href: "/triton-sleman.html" },
        { title: "New Colt L300", price: "Mulai Rp 230.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" }
    ]} />

</Layout>
