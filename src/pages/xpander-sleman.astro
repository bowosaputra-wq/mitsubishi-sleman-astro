---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import carsData from '../data/cars.json';

const car = carsData.cars.find(c => c.id === 'xpander');
const variants = car?.variants || [];
---

<Layout title="Harga Mitsubishi Xpander Sleman 2026 | MPV Keluarga No. 1 – Mitsubishi Sleman" description="Harga terbaru Mitsubishi Xpander di Sleman Yogyakarta 2026. Mesin 1.5L MIVEC 105 PS, kabin senyap, dan fitur lengkap. Hubungi Putra Sales Mitsubishi." image="/images/xpander.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Xpander 2026",
      "image": "https://mitsubishi-sleman.online/images/xpander.webp",
      "description": "MPV keluarga terlaris dengan kenyamanan maksimal dan kapasitas 7 penumpang. Tersedia di Sleman Yogyakarta melalui Putra Sales.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "New Xpander Ultimate CVT",
          "priceCurrency": "IDR",
          "price": "350000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "New Xpander Exceed Tourer CVT",
          "priceCurrency": "IDR",
          "price": "305000000",
          "availability": "https://schema.org/InStock"
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Xpander" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Xpander Sleman 2026</h1>
        <p>Evolusi MPV Keluarga Terbaik. Rasakan kenyamanan kabin paling senyap di kelasnya untuk kebahagiaan keluarga Anda.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/xpander.webp" alt="Mitsubishi Xpander Ultimate 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian Xpander -->
            <div class="product-card">
                <h2>Harga New Xpander Sleman 2026</h2>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian Xpander</th>
                            <th>Transmisi</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants.map((v, index) => (
                            <tr style={index === 0 ? "background: #fff5f5;" : undefined}>
                                <td>{index === 0 ? <strong>{v.name}</strong> : v.name}</td>
                                <td>{v.transmission}</td>
                                <td class="price-col">
                                    {index === 0 ? <strong>{v.price}</strong> : v.price}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo DP mulai Rp 15 Juta-an. Hubungi Putra untuk hitungan pasti!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Canggihnya Fitur New Xpander</h2>
                <table class="spec-table">
                    <tr><th>Dimensi</th><td>4.595 x 1.750 x 1.750 mm</td></tr>
                    <tr><th>Mesin</th><td>1.5L MIVEC DOHC 16 Valve, 1.499 cc</td></tr>
                    <tr><th>Tenaga Maks</th><td>105 PS (77 kW) @ 6.000 rpm</td></tr>
                    <tr><th>Torsi Maks</th><td>141 Nm @ 4.000 rpm</td></tr>
                    <tr><th>Transmisi</th><td>CVT (Smooth) / 5-Speed Manual</td></tr>
                    <tr><th>Ground Clearance</th><td>220 mm</td></tr>
                    <tr><th>Multimedia</th><td>8" Touchscreen & Smartphone Link</td></tr>
                    <tr><th>Keselamatan</th><td>Active Yaw Control (AYC), ASC, HSA, 6 Airbags (Ultimate)</td></tr>
                    <tr><th>Kapasitas</th><td>7 Penumpang</td></tr>
                    <tr><th>Fitur Premium</th><td>EPB with Auto Hold, Wireless Charger (Ultimate)</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">6 SRS Airbags</span>
                    <span class="feature-pill">Active Yaw Control (AYC)</span>
                    <span class="feature-pill">Cruise Control</span>
                    <span class="feature-pill">Wireless Charger</span>
                    <span class="feature-pill">Electric Parking Brake</span>
                    <span class="feature-pill">LED Projector Headlamp</span>
                    <span class="feature-pill">High Ground Clearance</span>
                    <span class="feature-pill">Soft Pad Material</span>
                </div>
            </div>

            <!-- Color Options -->
            <div class="product-card">
                <h2>Pilihan Warna Xpander</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 1rem;">
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Quartz White Pearl</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #e9ecef; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Blade Silver Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #212529; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Jet Black Mica</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #6c757d; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Graphite Gray Met.</p>
                    </div>
                </div>
                <p style="font-size: 0.75rem; color: var(--m-mid-grey); margin-top: 10px;">* Pilihan warna bervariasi sesuai tipe. Hubungi Putra untuk ketersediaan unit Sleman.</p>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit Xpander Sleman</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit New Xpander GLS MT (OTR Rp 276.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 55,2 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 6,8 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 5,1 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo DP Minim</div>
                        <div class="k-value">Mulai 10%</div>
                        <div class="k-sub">Khusus warga Sleman</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti & nego diskon maksimal.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Kenapa Xpander Jadi Pilihan Utama Keluarga?</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛋️ Kenyamanan Kelas Atas</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kualitas suspensi paling nyaman di kelasnya, meredam getaran dengan sempurna saat melewati jalanan bergelombang.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛡️ Active Yaw Control (AYC)</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Teknologi pengereman pintar untuk menjaga kestabilan bermanuver di jalan licin atau saat menikung tajam.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">📦 Bagasi Luas & Fleksibel</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kursi baris kedua dan ketiga bisa dilipat rata lantai, memberikan kapasitas bagasi maksimal untuk membawa barang belanjaan atau tas besar.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">💎 Resale Value Tinggi</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Xpander memiliki harga jual kembali yang paling stabil dan tinggi di kelas Low MPV Indonesia. Investasi kendaraan yang menguntungkan.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/xpander.webp"
                imageAlt="Xpander"
                price="Rp 276 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20Xpander%20di%20Sleman.%20Boleh%20minta%20info%20promonya%3F"
                waButtonText="Tanya Promo Xpander"
                ctaId="wa-xpander-cta"
                features={["Test Drive Door to Door", "Gratis Servis & Sparepart", "Pilihan MPV No. 1"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-cross-sleman.html">→ New Xpander Cross</a></li>
                    <li><a href="/pajero-sport-sleman.html">→ Pajero Sport Sleman</a></li>
                    <li><a href="/destinator-sleman.html">→ Mitsubishi Destinator</a></li>
                    <li><a href="/xforce-jogja.html">→ Xforce Jogja</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                    <li><a href="/blog/perbandingan-xpander-vs-xforce.html">Xpander vs Xforce</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Xpander Cross – SUV MPV", price: "Mulai Rp 350.000.000", image: "/images/xpander-cross.webp", alt: "Xpander Cross Sleman", href: "/xpander-cross-sleman.html" },
        { title: "Mitsubishi Destinator – Premium SUV", price: "Mulai Rp 400.000.000", image: "/images/destinator.webp", alt: "Destinator Sleman", href: "/destinator-sleman.html" },
        { title: "Pajero Sport – Promo", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" },
        { title: "New Colt L300 – Jagonya Cuan", price: "Rp 270.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" }
    ]} />

</Layout>
