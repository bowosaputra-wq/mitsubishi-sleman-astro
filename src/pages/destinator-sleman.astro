---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import carsData from '../data/cars.json';

const car = carsData.cars.find(c => c.id === 'destinator');
const variants = car?.variants || [];
---

<Layout title="Harga Destinator Sleman 2026 | SUV Premium 7-Seater Turbo – Mitsubishi Sleman" description="Harga dan promo Mitsubishi Destinator terbaru di Sleman Yogyakarta 2026. Mesin 1.5L Turbo 163 PS, 7-Seater Premium, Mitsubishi Connect. Hubungi Putra Sales Mitsubishi." image="/images/destinator.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi Destinator 2026",
      "image": "https://mitsubishi-sleman.online/images/destinator.webp",
      "description": "Premium Family SUV dengan mesin Turbo 163 PS dan kapasitas 7 penumpang. Tersedia di Sleman Yogyakarta melalui Putra Sales.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "Destinator GLS CVT",
          "priceCurrency": "IDR",
          "price": "400000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "Destinator Exceed CVT",
          "priceCurrency": "IDR",
          "price": "420000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "Destinator Ultimate CVT",
          "priceCurrency": "IDR",
          "price": "480000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "Destinator Ultimate Premium",
          "priceCurrency": "IDR",
          "price": "510000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "Mitsubishi Destinator" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Destinator Sleman 2026</h1>
        <p>The Real Premium Family SUV. Mesin Turbo bertenaga 163 PS dengan kenyamanan kelas atas untuk 7 penumpang.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/destinator.webp" alt="Mitsubishi Destinator 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian -->
            <div class="product-card">
                <h2>Harga Destinator Sleman 2026</h2>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian</th>
                            <th>Transmisi</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        {variants.map((v) => (
                            <tr style={v.name === "Ultimate Premium" ? "background: #fff5f5;" : undefined}>
                                <td>{v.name === "Ultimate Premium" ? <strong>{v.name}</strong> : v.name}</td>
                                <td>{v.transmission}</td>
                                <td class="price-col">
                                    {v.name === "Ultimate Premium" ? <strong>{v.price}</strong> : v.price}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo bunga 0% & Angsuran Ringan? Langsung chat Putra!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Canggihnya Fitur Destinator</h2>
                <table class="spec-table">
                    <tr><th>Dimensi</th><td>4.680 x 1.840 x 1.780 mm</td></tr>
                    <tr><th>Mesin</th><td>4B40 1.5L Turbo MIVEC, 1.499 cc</td></tr>
                    <tr><th>Tenaga Maks</th><td>163 PS (120 kW) @ 5.000 rpm</td></tr>
                    <tr><th>Torsi Maks</th><td>250 Nm @ 2.500–4.000 rpm</td></tr>
                    <tr><th>Mode Berkendara</th><td>Normal, Wet, Gravel, Mud, Sand</td></tr>
                    <tr><th>Interior</th><td>7-Seater, Hingga Synthetic Leather & Panoramic Sunroof</td></tr>
                    <tr><th>Multimedia</th><td>Hingga 12.3" Head Unit & 8" Digital Meter</td></tr>
                    <tr><th>Ground Clearance</th><td>244 mm (Tertinggi di kelasnya!)</td></tr>
                    <tr><th>Keselamatan</th><td>BSW, LCA, RCTA, FCM, AHB, ACC, AYC (Varian Ultimate)</td></tr>
                    <tr><th>Smart Feature</th><td>Mitsubishi Connect & Smartphone Link</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">1.5L Turbo 163 PS</span>
                    <span class="feature-pill">Mitsubishi Connect</span>
                    <span class="feature-pill">7-Seater Premium</span>
                    <span class="feature-pill">Panoramic Sunroof</span>
                    <span class="feature-pill">Yamaha Sound (Ultimate Premium)</span>
                    <span class="feature-pill">5 Driving Modes</span>
                    <span class="feature-pill">ADAS Diamond Sense</span>
                    <span class="feature-pill">Hands-free Power Tailgate</span>
                </div>
            </div>

            <!-- Perbandingan Varian & Fitur -->
            <div class="product-card">
                <h2>Perbandingan Varian & Fitur</h2>
                <p style="font-size: 0.9rem; color: var(--m-mid-grey); margin-bottom: 1.2rem;">
                    Mitsubishi Destinator hadir dalam 4 pilihan varian utama. Perbedaan fitur paling menonjol ada pada sistem audio, pengaturan jok, dan kenyamanan pintu bagasi elektrik.
                </p>
                <div class="comparison-table-wrapper">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>Fitur Utama</th>
                                <th>GLS</th>
                                <th>Exceed</th>
                                <th>Ultimate</th>
                                <th>Ultimate Premium</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Velg & Ban</td>
                                <td>18" Single-tone</td>
                                <td>18" Single-tone</td>
                                <td>18" Two-tone</td>
                                <td>18" Two-tone</td>
                            </tr>
                            <tr>
                                <td>Meter Cluster</td>
                                <td>4.2" MID</td>
                                <td>8" Digital</td>
                                <td>8" Digital</td>
                                <td>8" Digital</td>
                            </tr>
                            <tr>
                                <td>Smartphone Link</td>
                                <td>8-Inch Display</td>
                                <td>12.3-Inch Display</td>
                                <td>12.3-Inch Display</td>
                                <td>12.3-Inch Display</td>
                            </tr>
                            <tr>
                                <td>Audio System</td>
                                <td>4 Speakers</td>
                                <td>6 Speakers</td>
                                <td>6 Speakers</td>
                                <td class="feature-highlight">Yamaha Premium (8 Spk)</td>
                            </tr>
                            <tr>
                                <td>AC System</td>
                                <td>Front Manual</td>
                                <td>Dual Zone Auto</td>
                                <td>Dual Zone Auto</td>
                                <td>Dual Zone Auto</td>
                            </tr>
                            <tr>
                                <td>Bahan Jok</td>
                                <td>Fabric</td>
                                <td>Fabric</td>
                                <td>Synthetic Leather</td>
                                <td>Synthetic Leather</td>
                            </tr>
                            <tr>
                                <td>Power Seat (Driver)</td>
                                <td><span class="cross-icon">❌ Manual</span></td>
                                <td><span class="cross-icon">❌ Manual</span></td>
                                <td><span class="cross-icon">❌ Manual</span></td>
                                <td class="feature-highlight"><span class="check-icon">✔️ Ada (Electric)</span></td>
                            </tr>
                            <tr>
                                <td>Power Tailgate</td>
                                <td><span class="cross-icon">❌ Tidak Ada</span></td>
                                <td><span class="cross-icon">❌ Tidak Ada</span></td>
                                <td><span class="cross-icon">❌ Tidak Ada</span></td>
                                <td class="feature-highlight"><span class="check-icon">✔️ Hands-free</span></td>
                            </tr>
                            <tr>
                                <td>Safety (ADAS)</td>
                                <td>Basic</td>
                                <td>Cruise Control</td>
                                <td>Full Diamond Sense</td>
                                <td>Full Diamond Sense</td>
                            </tr>
                            <tr>
                                <td>Sunroof & Ambient</td>
                                <td><span class="cross-icon">❌</span></td>
                                <td><span class="cross-icon">❌</span></td>
                                <td><span class="check-icon">✔️ Ada</span></td>
                                <td><span class="check-icon">✔️ Ada</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Color Options -->
            <div class="product-card">
                <h2>Pilihan Warna Destinator</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 1rem;">
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #212529; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Jet Black Mica</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Quartz White Pearl</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #e9ecef; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Blade Silver Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #6c757d; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Graphite Gray Met.</p>
                    </div>
                    <div style="text-align: center;">
                        <div style="width: 100%; height: 60px; background: #1a3a5f; border: 1px solid #ddd; border-radius: 4px;"></div>
                        <p style="font-size: 0.8rem; margin-top: 5px;">Lunar Blue</p>
                    </div>
                </div>
                <p style="font-size: 0.75rem; color: var(--m-mid-grey); margin-top: 10px;">* Warna Lunar Blue tersedia eksklusif untuk varian Ultimate.</p>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit Destinator Sleman</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit Destinator GLS CVT (OTR Rp 400.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 80 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 9,6 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 7,2 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo DP Minim</div>
                        <div class="k-value">Mulai 10%</div>
                        <div class="k-sub">Tersedia via Dipo</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti & nego diskon maksimal.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Alasan Memilih Destinator</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🚀 Mesin Turbo 163 PS</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Performa mesin 1.5L Turbo yang bertenaga. Siap membawa keluarga berlibur ke area tanjakan Tawangmangu atau Kaliurang tanpa hambatan.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">👨‍👩‍👧‍👦 7-Seater Premium</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kabin luas dengan material kulit sintetis anti-panas. Sangat ideal untuk perjalanan keluarga besar menyusuri destinasi wisata di Yogyakarta.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">📲 Mitsubishi Connect</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Kontrol unit dari smartphone. Lacak lokasi unit dan cek status kendaraan secara real-time untuk keamanan ekstra saat parkir di lokasi wisata.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">⛰️ Ground Clearance 244mm</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">GC paling tinggi di kelasnya. Memberikan kepercayaan diri penuh saat harus melewati jalanan rusak atau banjir ringan di wilayah Sleman.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/destinator.webp"
                imageAlt="Destinator"
                price="Rp 400 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20Mitsubishi%20Destinator%20di%20Sleman.%20Boleh%20info%20promo%20dan%20ketersediaan%20unit%3F"
                waButtonText="Tanya Promo Destinator"
                ctaId="wa-destinator-cta"
                features={["Test Drive Door to Door", "Unit Ready Stock!", "Bunga 0% - DP 10%"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-sleman.html">→ New Xpander Sleman</a></li>
                    <li><a href="/xpander-cross-sleman.html">→ New Xpander Cross</a></li>
                    <li><a href="/pajero-sport-sleman.html">→ Pajero Sport Sleman</a></li>
                    <li><a href="/xforce-jogja.html">→ Xforce Jogja</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Artikel Berguna</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/blog/kredit-mitsubishi-sleman.html">Tips Kredit Cepat Lolos</a></li>
                    <li><a href="/blog/perbandingan-xpander-vs-xforce.html">Xpander vs Xforce</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Xpander – MPV Pilihan", price: "Mulai Rp 276.000.000", image: "/images/xpander.webp", alt: "Xpander Sleman", href: "/xpander-sleman.html" },
        { title: "New Xpander Cross – SUV MPV", price: "Rp 377.500.000", image: "/images/xpander-cross.webp", alt: "Xpander Cross Sleman", href: "/xpander-cross-sleman.html" },
        { title: "Pajero Sport – Promo Bunga 0%", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" },
        { title: "New Colt L300 – Jagonya Cuan", price: "Mulai Rp 270.000.000", image: "/images/l300.webp", alt: "L300 Sleman", href: "/l300-sleman.html" }
    ]} />

</Layout>

<style>
    .comparison-table-wrapper {
        overflow-x: auto;
        margin-top: 0.5rem;
        border-radius: 8px;
        border: 1px solid var(--m-border);
    }
    .comparison-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        min-width: 650px;
    }
    .comparison-table th {
        background: #f8f9fa;
        color: var(--m-black);
        padding: 12px 10px;
        text-align: center;
        border-bottom: 2px solid var(--m-border);
        border-right: 1px solid var(--m-border);
    }
    .comparison-table th:last-child { border-right: none; }
    .comparison-table th:first-child { text-align: left; background: #fff; }
    .comparison-table td {
        padding: 12px 10px;
        text-align: center;
        border-bottom: 1px solid #eee;
        border-right: 1px solid #eee;
        color: var(--m-mid-grey);
        vertical-align: middle;
    }
    .comparison-table td:last-child { border-right: none; }
    .comparison-table td:first-child {
        text-align: left;
        color: var(--m-dark-grey);
        font-weight: 600;
        background: #fcfcfc;
        border-right: 1px solid var(--m-border);
    }
    .comparison-table tr:last-child td { border-bottom: none; }
    .comparison-table tr:hover td { background: #fffafa; }
    .feature-highlight {
        color: var(--m-red);
        font-weight: 700;
        background: #fff5f5 !important;
    }
    .check-icon { color: #28a745; font-weight: bold; }
    .cross-icon { color: #dc3545; opacity: 0.7; font-size: 0.85rem; }
    
    @media (max-width: 768px) {
        .comparison-table { font-size: 0.82rem; }
        .comparison-table th, .comparison-table td { padding: 10px 8px; }
    }
</style>

