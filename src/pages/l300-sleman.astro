---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SidebarCTA from '../components/SidebarCTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
---

<Layout title="Harga L300 Sleman 2026 | Jagonya Pikap – Mitsubishi Sleman" description="Harga terbaru Mitsubishi Colt L300 di Sleman Yogyakarta 2026. Mesin Euro 4 bertenaga, kapasitas angkut 1 ton, irit BBM. Hubungi Putra Sales Mitsubishi." image="/images/l300.webp">
    <Fragment slot="head">
        <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Mitsubishi New Colt L300",
      "image": "https://mitsubishi-sleman.online/images/l300.webp",
      "description": "Pikap legendaris dengan mesin Euro 4 bertenaga dan irit BBM. Ideal untuk usaha pengangkutan di Sleman Yogyakarta.",
      "brand": { "@type": "Brand", "name": "Mitsubishi" },
      "offers": [
        {
          "@type": "Offer",
          "name": "New Colt L300 Flat Deck",
          "priceCurrency": "IDR",
          "price": "270000000",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "AutoDealer", "name": "Mitsubishi Sleman – Putra Sales", "url": "https://mitsubishi-sleman.online" }
        },
        {
          "@type": "Offer",
          "name": "New Colt L300 Cab Chassis",
          "priceCurrency": "IDR",
          "price": "265500000",
          "availability": "https://schema.org/InStock"
        }
      ]
    }
    </script>
    </Fragment>

<Breadcrumb items={[
    { label: "Produk", href: "/#products" },
    { label: "New Colt L300" }
]} />

    <div class="page-hero">
        <h1>Harga Mitsubishi Colt L300 Sleman 2026</h1>
        <p>Jagonya Pikap! Mesin Euro 4 Lebih Bertenaga, Irit BBM, & Muatan Luas. Partner Setia Bisnis Anda.</p>
    </div>

    <div class="product-layout">
        <div class="product-main">

            <img src="/images/l300.webp" alt="Mitsubishi New Colt L300 2026 – Sleman Yogyakarta" class="product-image-main">

            <!-- Harga & Varian -->
            <div class="product-card">
                <h2>Harga L300 Sleman 2026</h2>
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Varian L300</th>
                            <th>Tipe Karoseri</th>
                            <th class="price-col">Harga OTR Jogja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background: #fff5f5;">
                            <td><strong>Pick Up Flat Deck</strong></td>
                            <td>Bak Rata</td>
                            <td class="price-col"><strong>Rp 270.000.000</strong></td>
                        </tr>
                        <tr>
                            <td>Cabin Chassis</td>
                            <td>Tanpa Bak</td>
                            <td class="price-col">Rp 265.500.000</td>
                        </tr>
                    </tbody>
                </table>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 8px;">* Harga OTR Yogyakarta. Promo DP mulai Rp 15 Juta-an. Hubungi Putra untuk hitungan pasti!</p>
            </div>

            <!-- Spesifikasi -->
            <div class="product-card">
                <h2>Spesifikasi Utama L300 Euro 4</h2>
                <table class="spec-table">
                    <tr><th>Mesin</th><td>4N14 - DOHC 16 Valve, Common Rail Turbo</td></tr>
                    <tr><th>Kapasitas Mesin</th><td>2.268 cc (Euro 4)</td></tr>
                    <tr><th>Tenaga Maks</th><td>99.25 PS (73 kW) @ 3.500 rpm</td></tr>
                    <tr><th>Torsi Maks</th><td>200 Nm @ 1.000–3.500 rpm</td></tr>
                    <tr><th>Transmisi</th><td>5-Speed Manual</td></tr>
                    <tr><th>Dimensi Bak (Flat Deck)</th><td>2.630 x 1.600 x 310 mm</td></tr>
                    <tr><th>Radius Putar</th><td>4,9 meter (Lincah!)</td></tr>
                    <tr><th>Ground Clearance</th><td>195 mm</td></tr>
                    <tr><th>Bahan Bakar</th><td>Diesel (Kapasitas 47 Liter)</td></tr>
                    <tr><th>Fitur Unggulan</th><td>Power Steering, Kabin Lebih Luas & Nyaman</td></tr>
                </table>
                <div class="feature-pills">
                    <span class="feature-pill">Mesin Euro 4</span>
                    <span class="feature-pill">Bak Lebih Luas</span>
                    <span class="feature-pill">Power Steering</span>
                    <span class="feature-pill">Muatan 1 Ton</span>
                    <span class="feature-pill">Irit Bahan Bakar</span>
                    <span class="feature-pill">Perawatan Mudah</span>
                </div>
            </div>

            <!-- Informasi Estimasi Kredit -->
            <div class="product-card">
                <h2>Informasi Estimasi Kredit L300 Sleman</h2>
                <p style="font-size: 0.9rem; margin-bottom: 1rem; color: var(--m-mid-grey);">Estimasi kredit L300 Pick Up Flat Deck (OTR Rp 270.000.000), DP 20%:</p>
                <div class="kredit-grid">
                    <div class="kredit-card">
                        <div class="k-label">DP 20%</div>
                        <div class="k-value">Rp 54 Jt</div>
                        <div class="k-sub">Dari Total OTR</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 6,7 Jt</div>
                        <div class="k-sub">Tenor 36 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Cicilan/Bulan</div>
                        <div class="k-value">~Rp 4,9 Jt</div>
                        <div class="k-sub">Tenor 60 bulan</div>
                    </div>
                    <div class="kredit-card">
                        <div class="k-label">Promo DP Minim</div>
                        <div class="k-value">10%</div>
                        <div class="k-sub">Proses Cepat</div>
                    </div>
                </div>
                <p style="font-size: 0.82rem; color: var(--m-mid-grey); margin-top: 12px;">* Simulasi perkiraan. Hubungi Putra untuk hitungan pasti sesuai domisili Sleman/Jogja.</p>
            </div>

            <!-- Review / About -->
            <div class="product-card">
                <h2>Kenapa L300 Jagonya Cari Cuan?</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 1.2rem;">
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">💪 Mesin Euro 4 Bertenaga</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Mesin baru 2.2L Euro 4 memberikan torsi besar sejak putaran rendah (1.000 RPM), sangat tangguh di tanjakan curam.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">📐 Kargo Lebih Luas</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Ukuran bak kini 8% lebih luas, memungkinkan Anda membawa lebih banyak muatan dalam sekali perjalanan. Lebih efisien!</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">🛠️ Perawatan Termudah</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">Jaringan bengkel resmi yang luas di Yogyakarta dan suku cadang yang melimpah menjamin operasional bisnis Anda tidak terganggu.</p>
                    </div>
                    <div>
                        <div style="color: var(--m-red); font-weight: bold; margin-bottom: 5px;">💰 Nilai Jual Kembali Tinggi</div>
                        <p style="font-size: 0.92rem; color: var(--m-mid-grey); line-height: 1.5;">L300 dikenal sebagai aset bisnis dengan depresiasi harga terendah. Keuntungan maksimal saat Anda ingin meremajakan armada.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="product-sidebar">
            <SidebarCTA
                image="/images/l300.webp"
                imageAlt="Colt L300"
                price="Rp 270 Juta"
                waLink="https://wa.me/628974362666?text=Halo%20Putra%2C%20saya%20tertarik%20L300%20untuk%20usaha.%20Bisa%20info%20promo%20DP%20minim%3F"
                waButtonText="Tanya Promo L300"
                ctaId="wa-l300-cta"
                features={["Test Drive Ready", "DP Mulai 10%!", "Proses Kredit 1 Hari"]}
            />

            <!-- Related Links -->
            <div class="sidebar-widget" style="margin-top: 1.5rem;">
                <h3>Produk Lainnya</h3>
                <ul class="sidebar-link-list">
                    <li><a href="/xpander-sleman.html">→ New Xpander Sleman</a></li>
                    <li><a href="/xpander-cross-sleman.html">→ New Xpander Cross</a></li>
                    <li><a href="/pajero-sport-sleman.html">→ Pajero Sport Sleman</a></li>
                    <li><a href="/#products">→ Lihat Semua Unit</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <RelatedProducts products={[
        { title: "New Xpander – MPV Pilihan", price: "Mulai Rp 276.000.000", image: "/images/xpander.webp", alt: "Xpander Sleman", href: "/xpander-sleman.html" },
        { title: "Pajero Sport – SUV Raja", price: "Rp 799.000.000", image: "/images/pajero-sport.webp", alt: "Pajero Sport Sleman", href: "/pajero-sport-sleman.html" },
        { title: "New Xforce – SUV Stylish", price: "Rp 391.500.000", image: "/images/xforce.webp", alt: "Xforce Jogja", href: "/xforce-jogja.html" },
        { title: "Mitsubishi Destinator – Turbo", price: "Rp 400.000.000", image: "/images/destinator.webp", alt: "Destinator Sleman", href: "/destinator-sleman.html" }
    ]} />

</Layout>
