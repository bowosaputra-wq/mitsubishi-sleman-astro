---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../data/siteConfig.json';
import carsData from '../data/cars.json';
import galleryData from '../data/gallery.json';
import faqData from '../data/faq.json';
import leasingData from '../data/leasing.json';

const { cars } = carsData;
const galleryItems = galleryData.items || [];
const faqItems = faqData.items || [];
const leasingPartners = leasingData.partners || [];
const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
        },
    })),
};
---

<Layout title="Promo Mitsubishi Jogja - Harga Terbaik Sleman & Yogyakarta 2026" description="Promo Mitsubishi Jogja & Sleman Terbaik 2026. Harga Kredit Xpander, Pajero Sport, XForce, L300 di Jogja. Dealer Resmi Mitsubishi Yogyakarta.">
    {faqItems.length > 0 && (
        <Fragment slot="head">
            <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
        </Fragment>
    )}

    <!-- Hero Section -->
    <section id="home" class="hero" aria-label="Banner Utama">
        <div class="hero-content">
            <h1>{siteConfig.hero.title}</h1>
            <p>{siteConfig.hero.description}</p>
            <div class="hero-badges">
                <span class="hero-badge">✓ Door to Door Service</span>
                <span class="hero-badge">✓ DP Mulai 10%</span>
                <span class="hero-badge">✓ Proses 1 Hari</span>
                <span class="hero-badge">✓ Fast Response 24 Jam</span>
            </div>
            <a href="#products" class="cta-btn" style="padding: 1rem 2.5rem; font-size: 1.15rem;">Lihat Unit Ready 🚗</a>
        </div>
    </section>

    <!-- Promo Section with Slider -->
    <section id="promo" class={`promo-section ${siteConfig.promo.images && siteConfig.promo.images.length > 0 ? 'has-slider' : ''}`} aria-label="Promo Spesial">
        <div class="promo-slider" id="promoSlider">
            <div class="promo-slides">
                {siteConfig.promo.images && siteConfig.promo.images.length > 0 ? (
                    siteConfig.promo.images.map((img, index) => (
                        <div class="promo-slide" data-index={index}>
                            <img src={img.src} alt={img.alt || `Promo ${index + 1}`} class="promo-slide-image" loading="lazy" onerror="this.style.display='none'" />
                        </div>
                    ))
                ) : (
                    <div class="promo-slide">
                        <div class="promo-slide-content">
                            <h2>{siteConfig.promo.title}</h2>
                            <p>{siteConfig.promo.description}</p>
                            <a href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=Halo%20saya%20mau%20klaim%20Promo%20Spesial`} class="cta-btn" style="background: white; color: var(--m-red); margin-top: 28px; display: inline-block; font-weight: bold; padding: 0.9rem 2rem; font-size: 1.05rem;">Gaspol Ambil Promo 🚀</a>
                        </div>
                    </div>
                )}
            </div>
            <button class="promo-arrow promo-arrow-left" id="promoArrowLeft" aria-label="Slide sebelumnya">&#10094;</button>
            <button class="promo-arrow promo-arrow-right" id="promoArrowRight" aria-label="Slide berikutnya">&#10095;</button>
            <div class="promo-dots" id="promoDots"></div>
        </div>
    </section>

    <!-- Featured Products -->
    <section id="products" class="section" aria-label="Unit Unggulan">
        <h2 class="section-title">Unit Unggulan Mitsubishi Jogja</h2>
        <div class="car-grid">
            {cars.map((car) => (
                <div class="car-card">
                    <img src={car.image} alt={`Mitsubishi ${car.title} – Harga Terbaik Sleman 2026`} class="car-image" loading="lazy" />
                    <div class="car-details">
                        {car.badges && car.badges.map((badge) => (
                            <span class="car-badge">{badge}</span>
                        ))}
                        <h3 class="car-title">{car.title}</h3>
                        <p class="car-price">{car.price}</p>
                        <p>{car.description}</p>
                        <br />
                        {car.slug && car.slug !== "#" && (
                            <a href={`/${car.slug}`} class="cta-btn-outline" style="display:block; text-align:center; margin-bottom: 8px;">Detail &amp; Spesifikasi</a>
                        )}
                        <a href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(siteConfig.contact.waMessageTemplate + ' Promo Spesial ' + car.title)}`}
                            class="cta-btn" style="display:block; text-align:center;">Cek Promo 🏷️</a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Info & Tips (SEO Articles) -->
    <section id="tips" class="section-full" style="background-color: var(--m-light-grey);">
        <div style="max-width: 1200px; margin: 0 auto; padding: 4rem 20px;">
            <h2 class="section-title">Info &amp; Tips Mitsubishi Jogja</h2>
            <div class="car-grid">
                <!-- Tip 1 -->
                <div class="car-card" style="padding: 1.75rem; text-align: left;">
                    <div style="font-size: 2rem; margin-bottom: 10px;">⚙️</div>
                    <h3 class="car-title" style="font-size: 1.15rem;">
                        Keunggulan Mesin Pajero Sport Dakar
                    </h3>
                    <p style="font-size: 0.92rem; line-height: 1.7; margin-top: 8px;">Mesin diesel 4N15 MIVEC Turbocharged pada Pajero Sport Dakar menghasilkan tenaga 181 PS yang sangat responsif. Teknologi VGT optimal untuk tanjakan di area Jogja dan Sleman. Irit bahan bakar dan ramah lingkungan dengan standar Euro 4.</p>
                    <a href="/pajero-sport-sleman.html" style="font-size: 0.88rem; font-weight: 600; margin-top: 12px; display: inline-block;">Lihat Detail Pajero Sport →</a>
                </div>

                <!-- Tip 2 -->
                <div class="car-card" style="padding: 1.75rem; text-align: left;">
                    <div style="font-size: 2rem; margin-bottom: 10px;">💰</div>
                    <h3 class="car-title" style="font-size: 1.15rem;">Tips Kredit Xpander Murah</h3>
                    <p style="font-size: 0.92rem; line-height: 1.7; margin-top: 8px;">Dapatkan simulasi kredit termurah untuk New Xpander dengan DP mulai 10%. Kami bekerjasama dengan leasing terpercaya (Dipo, BCA, Mandiri) untuk proses cepat 1 hari approve. Konsultasikan budget Anda sekarang.</p>
                    <a href="/blog/kredit-mitsubishi-sleman.html" style="font-size: 0.88rem; font-weight: 600; margin-top: 12px; display: inline-block;">Baca Tips Kredit Lengkap →</a>
                </div>

                <!-- Tip 3 -->
                <div class="car-card" style="padding: 1.75rem; text-align: left;">
                    <div style="font-size: 2rem; margin-bottom: 10px;">🏠</div>
                    <h3 class="car-title" style="font-size: 1.15rem;">Mengapa Beli di Mitsubishi Sleman?</h3>
                    <p style="font-size: 0.92rem; line-height: 1.7; margin-top: 8px;">Kami memberikan layanan 'Door to Door' service untuk warga Sleman dan Yogyakarta. Test drive bisa diantar ke rumah. Diskon sparepart dan gratis jasa servis hingga 50.000 KM. Pelayanan ramah dan profesional 24 Jam.</p>
                    <a href="/dealer-mitsubishi-sleman.html" style="font-size: 0.88rem; font-weight: 600; margin-top: 12px; display: inline-block;">Tentang Dealer Kami →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <h2 class="section-title">Kenapa Beli di Sini?</h2>
        <div class="about-container">
            <div>
                <img src="/images/sun-sleman.webp" alt="Sales Mitsubishi Profesional Putra – Sleman Yogyakarta" class="about-image">
            </div>
            <div>
                <h3>Pelayanan Profesional Mitsubishi Jogja</h3>
                <p style="margin-top: 1rem;">Halo, saya Putra, Sales Consultant resmi Mitsubishi Jogja di Sleman, Yogyakarta (Sun Star Motor – Jl. Magelang Km. 14 depan RSUD Sleman).</p>
                <p style="margin-top: 1rem;">Saya siap membantu Anda memiliki mobil impian dengan proses yang cepat, mudah, dan transparan. Dapatkan promo DP ringan, bunga rendah, dan bonus menarik khusus pemesanan bulan ini di Mitsubishi Jogja.</p>
                <ul class="about-list" style="margin-top: 1.25rem;">
                    <li><strong>Proses Kredit Dibantu Sampai Approve</strong> (Nego Sampai Deal)</li>
                    <li><strong>Siap 24 Jam &amp; Fast Response</strong> via WhatsApp</li>
                    <li>Support Leasing Lengkap: BCA, Mandiri, Adira, Maybank, dll.</li>
                    <li>Layanan Home Service &amp; Test Drive Door to Door</li>
                    <li>Melayani KTP Jogja &amp; Jawa Tengah</li>
                </ul>
                <a href="/dealer-mitsubishi-sleman.html" class="cta-btn" style="display: inline-block; margin-top: 1.5rem;">Lihat Profil Dealer →</a>
            </div>
        </div>
    </section>

    {faqItems.length > 0 && (
        <section id="faq" class="section faq-home" aria-label="Pertanyaan Umum Mitsubishi Jogja">
            <h2 class="section-title">Pertanyaan Umum Mitsubishi Jogja</h2>
            <div class="faq-list">
                {faqItems.map((item) => (
                    <div class="faq-item">
                        <h3 class="faq-question">{item.question}</h3>
                        <p class="faq-answer">{item.answer}</p>
                    </div>
                ))}
            </div>
        </section>
    )}

    <!-- Gallery Section -->
    <section id="gallery" class="section-full" style="background: var(--m-white); padding-top: 1rem;">
        <div style="max-width: 1200px; margin: 0 auto; text-align: center;">
            <h2 class="section-title">Galeri Pelanggan Setia Mitsubishi</h2>
            <p style="color: var(--m-mid-grey); margin-bottom: 2rem;">Bukti nyata kepercayaan pelanggan kepada layanan Sales Mitsubishi Sleman.</p>
            <div class="gallery-grid">
                {galleryItems.map((item) => (
                    <div class="gallery-item">
                        <img src={item.image} alt={item.alt || item.title} loading="lazy">
                        <div class="gallery-overlay">
                            <div class="gallery-text">{item.title}</div>
                            {item.location && <div class="gallery-subtext">{item.location}</div>}
                        </div>
                    </div>
                ))}
            </div>
            <a href="https://wa.me/628974362666?text=Halo%20saya%20tertarik%20dengan%20pelayanan%20Mitsubishi%20Sleman" class="cta-btn-outline" style="margin-top: 2.5rem;"><i class="fab fa-whatsapp"></i> Chat Sales Sekarang & Jadilah Bagian Dari Galeri Ini</a>
        </div>
    </section>

    {leasingPartners.length > 0 && (
        <section id="leasing" class="section-full leasing-section">
            <div style="max-width: 1200px; margin: 0 auto;">
                <h2 class="section-title">Partner Pembiayaan Mitsubishi Jogja</h2>
                <div class="leasing-grid">
                    {leasingPartners.map((partner) => (
                        <div class="leasing-item">
                            {partner.logo && (
                                <img src={partner.logo} alt={partner.name} class="leasing-logo" title={partner.name} loading="lazy">
                            )}
                            <span class="leasing-name">{partner.name}</span>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )}
</Layout>
